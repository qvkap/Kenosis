#!/bin/sh -e

for f in $(find . -name "*[ch]"); do sed 's/volatile //g' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done
for f in $(find . -name "*[ch]"); do sed 's/\bregister //g' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done

# Some legacy djb code relies on old C qualifier semantics that cproc rejects.
# Defining these macros to empty keeps the package buildable without touching every source file.
echo "cproc -O2 -Dconst= -Dvolatile= -Dregister= -static" > conf-cc
echo "cproc -s -Dconst= -Dvolatile= -Dregister= -static" > conf-ld

# K&R C syntax used in a few files causes cproc to fail. Replace them with proper ANSI C definitions.
sed 's/int buffer_0_read(fd,buf,len) int fd; char \*buf; int len;/int buffer_0_read(int fd, char *buf, int len)/' buffer_0.c > buffer_0.c.tmp || true
mv buffer_0.c.tmp buffer_0.c || true
sed 's/int wait_nohang(wstat) int \*wstat;/int wait_nohang(int *wstat)/' wait_nohang.c > wait_nohang.c.tmp || true
mv wait_nohang.c.tmp wait_nohang.c || true
sed 's/int wait_pid(wstat,pid) int \*wstat; int pid;/int wait_pid(int *wstat, int pid)/' wait_pid.c > wait_pid.c.tmp || true
mv wait_pid.c.tmp wait_pid.c || true

make
make DESTDIR="$1" install
