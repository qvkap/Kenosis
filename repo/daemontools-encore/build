#!/bin/sh -e

for f in $(find . -name "*.[ch]"); do sed 's/volatile //g' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done
for f in $(find . -name "*.[ch]"); do sed 's/register //g' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done

# K&R C syntax used in a few files causes cproc to fail. Replace them with proper ANSI C definitions.
sed -i 's/int buffer_0_read(fd,buf,len) int fd; char \*buf; int len;/int buffer_0_read(int fd, char *buf, int len)/' buffer_0.c || true
sed -i 's/int wait_nohang(wstat) int \*wstat;/int wait_nohang(int *wstat)/' wait_nohang.c || true
sed -i 's/int wait_pid(wstat,pid) int \*wstat; int pid;/int wait_pid(int *wstat, int pid)/' wait_pid.c || true

echo "cproc -O2 -static" > conf-cc
echo "cproc -s -static" > conf-ld

make
make DESTDIR="$1" install
