#!/bin/sh -e

for f in $(find . -name "*[ch]"); do sed 's/volatile //g' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done
for f in $(find . -name "*[ch]"); do sed 's/register //g' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done

# Some legacy djb code relies on old C qualifier semantics that cproc rejects.
# Defining these macros to empty keeps the package buildable without touching every source file.
echo "cproc -O2 -Dconst= -Dvolatile= -Dregister= -static" > conf-cc
echo "cproc -s -Dconst= -Dvolatile= -Dregister= -static" > conf-ld

# K&R C syntax used in a few files causes cproc to fail. Replace them with proper ANSI C definitions.
sed 's/int buffer_0_read(fd,buf,len) int fd; char \*buf; int len;/int buffer_0_read(int fd, char *buf, int len)/' buffer_0.c > buffer_0.c.tmp && mv buffer_0.c.tmp buffer_0.c
sed 's/int buffer_1_read(fd,buf,len) int fd; char \*buf; int len;/int buffer_1_read(int fd, char *buf, int len)/' buffer_1.c > buffer_1.c.tmp && mv buffer_1.c.tmp buffer_1.c 2>/dev/null || true
sed 's/int buffer_2_read(fd,buf,len) int fd; char \*buf; int len;/int buffer_2_read(int fd, char *buf, int len)/' buffer_2.c > buffer_2.c.tmp && mv buffer_2.c.tmp buffer_2.c 2>/dev/null || true
sed 's/int buffer_0_read(fd,buf,len)/int buffer_0_read(int fd, char *buf, int len)/' buffer_0.c > buffer_0.c.tmp && mv buffer_0.c.tmp buffer_0.c
sed 's/int buffer_1_read(fd,buf,len)/int buffer_1_read(int fd, char *buf, int len)/' buffer_1.c > buffer_1.c.tmp && mv buffer_1.c.tmp buffer_1.c 2>/dev/null || true
sed 's/int buffer_2_read(fd,buf,len)/int buffer_2_read(int fd, char *buf, int len)/' buffer_2.c > buffer_2.c.tmp && mv buffer_2.c.tmp buffer_2.c 2>/dev/null || true
sed 's/int fd; char \*buf; int len;//' buffer_0.c > buffer_0.c.tmp && mv buffer_0.c.tmp buffer_0.c
sed 's/int fd; char \*buf; int len;//' buffer_1.c > buffer_1.c.tmp && mv buffer_1.c.tmp buffer_1.c 2>/dev/null || true
sed 's/int fd; char \*buf; int len;//' buffer_2.c > buffer_2.c.tmp && mv buffer_2.c.tmp buffer_2.c 2>/dev/null || true
sed 's/int wait_nohang(wstat) int \*wstat;/int wait_nohang(int *wstat)/' wait_nohang.c > wait_nohang.c.tmp && mv wait_nohang.c.tmp wait_nohang.c
sed 's/int wait_pid(wstat,pid) int \*wstat; int pid;/int wait_pid(int *wstat, int pid)/' wait_pid.c > wait_pid.c.tmp && mv wait_pid.c.tmp wait_pid.c

# Buffer macro incompatibility
sed 's/#define BUFFER_INIT(op,fd,buf,len) { (buf), 0, (len), (fd), (op) }/#define BUFFER_INIT(op,fd,buf,len) { (buf), 0, (len), (fd), (int (\*)(int, char \*, int))(op) }/' buffer.h > buffer.h.tmp && mv buffer.h.tmp buffer.h
sed 's/int (\*op)();/int (\*op)(int, char \*, int);/' buffer.h > buffer.h.tmp && mv buffer.h.tmp buffer.h
sed 's/extern void buffer_init(buffer \*,int (\*)(),int,char \*,unsigned int);/extern void buffer_init(buffer \*,int (\*)(int, char \*, int),int,char \*,unsigned int);/' buffer.h > buffer.h.tmp && mv buffer.h.tmp buffer.h

make
make DESTDIR="$1" install
