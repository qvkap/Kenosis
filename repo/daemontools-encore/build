#!/bin/sh -e

for f in $(find . -name "*[ch]"); do sed 's/volatile //g' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done
for f in $(find . -name "*[ch]"); do sed 's/register //g' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done

# Some legacy djb code relies on old C qualifier semantics that cproc rejects.
# Defining these macros to empty keeps the package buildable without touching every source file.
echo "cproc -O2 -Dconst= -Dvolatile= -Dregister= -static" > conf-cc
echo "cproc -s -Dconst= -Dvolatile= -Dregister= -static" > conf-ld

# K&R C syntax used in a few files causes cproc to fail. Replace them with proper ANSI C definitions.
sed 's/int buffer_0_read(fd,buf,len) int fd; char \*buf; int len;/int buffer_0_read(int fd, char *buf, int len)/' buffer_0.c > buffer_0.c.tmp && mv buffer_0.c.tmp buffer_0.c || true
sed 's/int wait_nohang(wstat) int \*wstat;/int wait_nohang(int *wstat)/' wait_nohang.c > wait_nohang.c.tmp && mv wait_nohang.c.tmp wait_nohang.c || true
sed 's/int wait_pid(wstat,pid) int \*wstat; int pid;/int wait_pid(int *wstat, int pid)/' wait_pid.c > wait_pid.c.tmp && mv wait_pid.c.tmp wait_pid.c || true

for f in $(find . -name "*.[ch]"); do sed 's/int (\*op)()/int (*op)(int, char *, int)/g' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done
for f in $(find . -name "*.[ch]"); do sed 's/int (\*)()/int (*)(int, char *, int)/g' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done

sed 's/(op)/(int (*)(int, char *, int))(op)/g' buffer.h > buffer.h.tmp && mv buffer.h.tmp buffer.h

# Cast const to non-const pointer
sed 's/buffer_init(&b,write,fd,buf,sizeof buf);/buffer_init(\&b,write,fd,(char *)buf,sizeof buf);/g' buffer_put.c > buffer_put.c.tmp && mv buffer_put.c.tmp buffer_put.c

# Fix sig pointer assignments
sed 's/void (\*sig_defaulthandler)() = SIG_DFL;/void (*sig_defaulthandler)(int) = (void (*)(int))SIG_DFL;/g' sig.c > sig.c.tmp && mv sig.c.tmp sig.c
sed 's/void (\*sig_ignorehandler)() = SIG_IGN;/void (*sig_ignorehandler)(int) = (void (*)(int))SIG_IGN;/g' sig.c > sig.c.tmp && mv sig.c.tmp sig.c
sed 's/extern void (\*sig_defaulthandler)();/extern void (*sig_defaulthandler)(int);/g' sig.h > sig.h.tmp && mv sig.h.tmp sig.h
sed 's/extern void (\*sig_ignorehandler)();/extern void (*sig_ignorehandler)(int);/g' sig.h > sig.h.tmp && mv sig.h.tmp sig.h
sed 's/extern void sig_catch(int,void (\*)());/extern void sig_catch(int,void (*)(int));/g' sig.h > sig.h.tmp && mv sig.h.tmp sig.h

make
make DESTDIR="$1" install
