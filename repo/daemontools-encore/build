#!/bin/sh -e

for f in $(find . -name "*.[ch]"); do sed 's/volatile //g' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done
for f in $(find . -name "*.[ch]"); do sed 's/register //g' "$f" > "$f.tmp" && mv "$f.tmp" "$f"; done

# K&R C syntax used in a few files causes cproc to fail. Replace them with proper ANSI C definitions.
sed 's/int buffer_0_read(fd,buf,len) int fd; char \*buf; int len;/int buffer_0_read(int fd, char *buf, int len)/' buffer_0.c > buffer_0.c.tmp && mv buffer_0.c.tmp buffer_0.c || true
sed 's/int wait_nohang(wstat) int \*wstat;/int wait_nohang(int *wstat)/' wait_nohang.c > wait_nohang.c.tmp && mv wait_nohang.c.tmp wait_nohang.c || true
sed 's/int wait_pid(wstat,pid) int \*wstat; int pid;/int wait_pid(int *wstat, int pid)/' wait_pid.c > wait_pid.c.tmp && mv wait_pid.c.tmp wait_pid.c || true

# Explicitly cast function pointers in BUFFER_INIT to (int (*)(int,char *,int)) to satisfy C11 types
sed 's/#define BUFFER_INIT(op,fd,buf,len) { (buf), 0, (len), (fd), (op) }/#define BUFFER_INIT(op,fd,buf,len) { (buf), 0, (len), (fd), (int (*)(int,char *,int))(op) }/' buffer.h > buffer.h.tmp && mv buffer.h.tmp buffer.h || true

# Fix unprototyped function pointers in buffer struct and functions for strict C11 compliance
sed 's/int (\*op)()/int (*op)(int,char *,int)/' buffer.h > buffer.h.tmp && mv buffer.h.tmp buffer.h || true
sed 's/int (\*)()/int (*)(int,char *,int)/' buffer.h > buffer.h.tmp && mv buffer.h.tmp buffer.h || true
sed 's/int (\*op)()/int (*op)(int,char *,int)/' buffer.c > buffer.c.tmp && mv buffer.c.tmp buffer.c || true
sed 's/int (\*op)()/int (*op)(int,char *,int)/' buffer_get.c > buffer_get.c.tmp && mv buffer_get.c.tmp buffer_get.c || true
sed 's/int (\*op)()/int (*op)(int,char *,int)/' buffer_put.c > buffer_put.c.tmp && mv buffer_put.c.tmp buffer_put.c || true

echo "cproc -O2 -static" > conf-cc
echo "cproc -s -static" > conf-ld

make
make DESTDIR="$1" install
