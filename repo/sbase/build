#!/bin/sh -e

echo "CC = cproc" >> config.mk
echo "LDFLAGS = -static" >> config.mk
sed -i 's/^YACC = .*/YACC = byacc/' config.mk

# Workaround for cproc lack of volatile store support
find . -name "*.[ch]" -exec sed -i 's/volatile //g' {} + || true

make sbase-box
make PREFIX=/usr DESTDIR="$1" sbase-box-install
